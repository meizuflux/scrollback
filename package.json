    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@solidjs/router": "^0.16.3",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "solid-js": "^1.9.15",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
